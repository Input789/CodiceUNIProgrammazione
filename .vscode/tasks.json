{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: g++.exe build active file",
            "type": "process",
            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "$sources = @('${file}'); $library = Join-Path '${fileDirname}' 'library.cpp'; if ((Test-Path -LiteralPath $library) -and ('${file}' -ne $library)) { $sources += $library }; & 'C:\\msys64\\ucrt64\\bin\\g++.exe' -fdiagnostics-color=always -g @sources -o '${fileDirname}\\${fileBasenameNoExtension}.exe'; exit $LASTEXITCODE"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build active C++ file; also links library.cpp when it is in the same folder."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "process",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "$sources = @('${file}'); $library = Join-Path '${fileDirname}' 'library.cpp'; if ((Test-Path -LiteralPath $library) -and ('${file}' -ne $library)) { $sources += $library }; & 'C:\\msys64\\ucrt64\\bin\\g++.exe' -fdiagnostics-color=always -g @sources -o '${fileDirname}\\${fileBasenameNoExtension}.exe'; exit $LASTEXITCODE"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Build active C++ file; also links library.cpp when it is in the same folder."
        }
    ]
}
